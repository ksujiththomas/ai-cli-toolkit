#!/usr/bin/env bash

# Resolve actual script directory even when invoked via symlink
TARGET_FILE="${BASH_SOURCE[0]}"
while [ -L "$TARGET_FILE" ]; do
    TARGET_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"
    TARGET_FILE="$(readlink "$TARGET_FILE")"
    [[ $TARGET_FILE != /* ]] && TARGET_FILE="$TARGET_DIR/$TARGET_FILE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"

if [ -f "$SCRIPT_DIR/config.env" ]; then
    source "$SCRIPT_DIR/config.env"
else
    echo "Error: config.env not found in $SCRIPT_DIR"
    exit 1
fi

PROJECT_REQ="$*"
if [ -z "$PROJECT_REQ" ]; then
    echo "Usage: abuild \"Describe the project you want to auto-build\""
    exit 1
fi

echo -e "\n==================================================="
echo " PHASE 1: Architecting System & File Tree"
echo -e "===================================================\n"

ARCH_PROMPT="You are a Lead Software Architect.
Decompose this project into discrete, modular code files.
OUTPUT ONLY VALID JSON raw array with no markdown formatting or extra text.

JSON Format:
[
  {
    \"path\": \"relative/file/path.ext\",
    \"description\": \"Specific purpose of this file and precise implementation requirements.\"
  }
]

Project Request: $PROJECT_REQ"

RAW_PLAN=$(ollama run "$CHAT_MODEL" <<INSIDE_HEREDOC
$ARCH_PROMPT
INSIDE_HEREDOC
)

CLEAN_JSON=$(echo "$RAW_PLAN" | perl -0777 -pe 's/<think>.*?<\/think>//gs; s/```json//g; s/```//g' | tr -d '\r')

if ! echo "$CLEAN_JSON" | python3 -m json.tool >/dev/null 2>&1; then
    echo "Error: Architect failed to generate valid JSON plan."
    echo "Raw output was:"
    echo "$RAW_PLAN"
    exit 1
fi

FILE_COUNT=$(echo "$CLEAN_JSON" | python3 -c "import sys, json; print(len(json.load(sys.stdin)))")
echo "Architect generated a $FILE_COUNT-file plan."

echo -e "\n==================================================="
echo " PHASE 2: Autonomous Code Building Loop (with Hardened Rules)"
echo -e "===================================================\n"

ACCUMULATED_CONTEXT=""

for (( i=0; i<$FILE_COUNT; i++ )); do
    FILE_PATH=$(echo "$CLEAN_JSON" | python3 -c "import sys, json; print(json.load(sys.stdin)[$i]['path'])")
    FILE_DESC=$(echo "$CLEAN_JSON" | python3 -c "import sys, json; print(json.load(sys.stdin)[$i]['description'])")

    echo "---------------------------------------------------"
    echo "Building [$((i+1))/$FILE_COUNT]: $FILE_PATH"
    echo "Purpose: $FILE_DESC"
    echo "---------------------------------------------------"

    mkdir -p "$(dirname "$FILE_PATH")"

    BUILD_PROMPT="You are a Senior Developer. Write the FULL, PRODUCTION-READY implementation for the following file:

File Path: $FILE_PATH
Requirements: $FILE_DESC

Overall Project Request: $PROJECT_REQ

PREVIOUSLY GENERATED FILES IN THIS PROJECT:
${ACCUMULATED_CONTEXT:-None yet (this is the first file).}

STRICT Code Generation Rules:
1. CONFIG FILES: Must ONLY declare/export variables. NEVER put functions inside config files that source the config file itself (causes infinite recursion segfault).
2. HELPER SCRIPTS: Must run single-pass and exit. Do NOT place infinite loops (while true) inside helper scripts if a launcher script handles orchestration.
3. RELATIVE SOURCING: Helper/launcher scripts MUST dynamically resolve directory path (e.g. SCRIPT_DIR=\"\$(cd \"\$(dirname \"\${BASH_SOURCE[0]}\")\" && pwd)\") to source config files safely regardless of execution directory.
4. PARSING SYSTEM DATA: When reading files like /proc, /sys, or logs, use robust AWK regex field separators (e.g., awk -F'[: ]+') instead of rigid fixed-column cut or fragile string matching.
5. MATCH VARIABLES: Match exact variable names and paths defined in PREVIOUSLY GENERATED FILES.
6. OUTPUT ONLY valid executable code with zero markdown wrapping, preamble, or postscript."

    FILE_CODE=$(ollama run "$CHAT_MODEL" <<INSIDE_HEREDOC
$BUILD_PROMPT
INSIDE_HEREDOC
)

    CLEAN_CODE=$(echo "$FILE_CODE" | perl -0777 -pe 's/<think>.*?<\/think>//gs; s/```[a-zA-Z]*\n//g; s/```//g')

    echo "$CLEAN_CODE" > "$FILE_PATH"

    if [[ "$FILE_PATH" == *.sh ]] || [[ "$FILE_PATH" == bin/* ]] || head -n 1 "$FILE_PATH" | grep -q "^#!"; then
        chmod +x "$FILE_PATH"
    fi

    ACCUMULATED_CONTEXT="${ACCUMULATED_CONTEXT}
--- START FILE: $FILE_PATH ---
$CLEAN_CODE
--- END FILE: $FILE_PATH ---
"

    echo "Saved -> $FILE_PATH ($(wc -l < "$FILE_PATH") lines)"
done

echo -e "\n==================================================="
echo " SUCCESS: Project build complete!"
echo -e "===================================================\n"
