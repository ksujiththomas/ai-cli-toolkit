# aicli settings. Managed by `aicli model` / `aicli config` - edit by hand if you like,
# but keep the KEY="value" format.

# Active Ollama model used for every subcommand.
CHAT_MODEL="qwen2.5-coder:7b"

# Build mode: how many of the most recently generated files are fed back to the
# model as context when generating the next file. Raise it for small projects
# where cross-file consistency matters most; lower it if you hit the model's
# context limit on big builds.
CONTEXT_WINDOW_FILES="5"

# Agent mode: which model plays which role. Leave a role unset (or delete its
# line) to follow CHAT_MODEL. Examples:
#   ARCHITECT_MODEL="llama3.1:8b"   # big-picture planning
#   BUILDER_MODEL="qwen2.5-coder:7b" # fast code writing with tools
#   REVIEWER_MODEL="llama3.1:8b"     # careful critique pass

# Agent autonomy: sandbox | confirm | dry-run
#   sandbox - shell commands run inside a bwrap jail (project dir read-write,
#             rest of the system read-only, no network); falls back to confirm
#             if bwrap is not installed.
#   confirm - ask before every shell command the agent wants to run.
#   dry-run - print every tool call, execute nothing (safe rehearsal).
AGENT_MODE="sandbox"

# Agent limits.
AGENT_MAX_STEPS="25"        # max tool-call turns per agent run (all phases)
AGENT_MAX_REVISIONS="2"     # reviewer -> builder fix rounds
AGENT_MAX_OUTPUT_CHARS="4000" # truncate individual tool outputs to this
AGENT_CMD_TIMEOUT="60"      # seconds: per shell command the agent runs
AGENT_MODEL_TIMEOUT="300"   # seconds: per model call timeout
