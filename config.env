# aicli settings. Managed by `aicli model` / `aicli config` - edit by hand if you like,
# but keep the KEY="value" format.

# Active Ollama model used for every subcommand.
CHAT_MODEL="qwen2.5-coder:7b"

# Build mode: how many of the most recently generated files are fed back to the
# model as context when generating the next file. Raise it for small projects
# where cross-file consistency matters most; lower it if you hit the model's
# context limit on big builds.
CONTEXT_WINDOW_FILES="5"
