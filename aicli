    }
    # (Re)build the deliverables arrays from $PLAN_RAW. Returns 1 when empty.
    agent_parse_deliverables() {
        DELIV_PATHS=() DELIV_PURPOSE=() DELIV_DONE=() DELIV_SECS=()
        [ -n "$PLAN_RAW" ] || return 1
        local DLV_RAW
        DLV_RAW="$(printf '%s' "$PLAN_RAW" | parse_deliverables)" || return 1
        local -a DLV=()
