                        if agent_cmd_denied "$a1"; then
                            tool_result="ERROR: command denied by safety policy."
                        elif [ "$MODE" = "dry-run" ]; then
                            tool_result="dry-run: would run: $a1 (not executed)"
                        elif [ "$MODE" = "sandbox" ]; then
                            out="$(agent_run_sandboxed "$a1" "$PROJ")"; rc=$?
                            tool_result="[exit $rc]${NL}$out"
                        else
                            out="$(agent_run_confirmed "$a1")"; rc=$?
                            tool_result="[exit $rc]${NL}$out"
                        fi ;;
