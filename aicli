<VERDICT>{\"verdict\": \"approve\"}</VERDICT>
or
<VERDICT>{\"verdict\": \"revise\", \"notes\": \"concrete issues, e.g. 'styles.css is missing; split the hero section, it is too large'\"}</VERDICT>")" || CRIT_RAW=""
            local cvjson verdict="approve" notes=""
