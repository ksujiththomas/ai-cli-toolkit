#!/usr/bin/env bash

# Resolve actual script directory even when invoked via symlink
TARGET_FILE="${BASH_SOURCE[0]}"
while [ -L "$TARGET_FILE" ]; do
    TARGET_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"
    TARGET_FILE="$(readlink "$TARGET_FILE")"
    [[ $TARGET_FILE != /* ]] && TARGET_FILE="$TARGET_DIR/$TARGET_FILE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"

# Load configuration
CONFIG_FILE="$SCRIPT_DIR/config.env"
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
else
    CHAT_MODEL="qwen2.5-coder:7b"
fi

VERSION="2.2.0 (ai v1.0.0 | aarch v1.0.0 | abuild v1.4.0)"

show_help() {
    cat << 'HELP'
aicli v2.2.0 - Unified Local AI CLI Toolkit powered by Ollama

USAGE:
    aicli <subcommand> [options] "your prompt or request"

SUBCOMMANDS:
    ask, -a       Quick shell assistant & single-prompt Q&A.
    arch, -r      Architect system blueprints & JSON file-tree plans.
    build, -b     Autonomous multi-file developer loop with cumulative context memory.
    model, -m     View or change the active Ollama local model.

FLAGS:
    -h, --help    Show this help message and exit.
    -v, --version Show version information.

EXAMPLES:
    aicli model                    Show current active model and available Ollama models.
    aicli model llama3:8b          Switch active model to llama3:8b.
    aicli ask "How do I check open ports using ss or netstat?"
    aicli build "A 2-file Bash tool: config/net.conf and scripts/netmon.sh"
HELP
}

# Parse primary subcommand
SUBCOMMAND="$1"
shift

case "$SUBCOMMAND" in
    model|-m)
        NEW_MODEL="$1"
        if [ -z "$NEW_MODEL" ]; then
            echo "==================================================="
            echo " Active Ollama Model: ${CHAT_MODEL:-qwen2.5-coder:7b}"
            echo "==================================================="
            echo -e "\nAvailable Local Models (Ollama):"
            ollama list | awk 'NR>1 {print "  - " $1}'
            echo -e "\nTo switch models, run:"
            echo "  aicli model <model_name>"
            exit 0
        fi

        # Verify model exists in Ollama
        if ! ollama list | grep -q "^${NEW_MODEL}:\|^${NEW_MODEL} "; then
            echo "Warning: Model '$NEW_MODEL' is not currently downloaded in Ollama."
            read -p "Do you want to pull '$NEW_MODEL' now? (y/N): " choice
            case "$choice" in
                y|Y)
                    ollama pull "$NEW_MODEL"
                    ;;
                *)
                    echo "Aborted model change."
                    exit 1
                    ;;
            esac
        fi

        echo "CHAT_MODEL=\"$NEW_MODEL\"" > "$CONFIG_FILE"
        echo "Active model updated to: $NEW_MODEL"
        ;;

    ask|-a)
        PROMPT="$*"
        if [ -z "$PROMPT" ]; then
            echo "Usage: aicli ask \"Your question or request\""
            exit 1
        fi
        ollama run "$CHAT_MODEL" "$PROMPT"
        ;;

    arch|-r)
        PROMPT="$*"
        if [ -z "$PROMPT" ]; then
            echo "Usage: aicli arch \"Describe the system architecture to design\""
            exit 1
        fi
        ARCH_PROMPT="You are a Principal Software Architect.
Provide a high-level system architectural blueprint, component design, and a JSON file tree.

Project Request: $PROMPT"
        ollama run "$CHAT_MODEL" "$ARCH_PROMPT"
        ;;

    build|-b)
        PROJECT_REQ="$*"
        if [ -z "$PROJECT_REQ" ]; then
            echo "Usage: aicli build \"Describe the project you want to auto-build\""
            exit 1
        fi

        echo -e "\n==================================================="
        echo " PHASE 1: Architecting System & File Tree (Model: $CHAT_MODEL)"
        echo -e "==================================================-\n"

        ARCH_PROMPT="You are a Lead Software Architect.
Decompose this project into discrete, modular code files.
OUTPUT ONLY VALID JSON raw array with no markdown formatting or extra text.

JSON Format:
[
  {
    \"path\": \"relative/file/path.ext\",
    \"description\": \"Specific purpose of this file and precise implementation requirements.\"
  }
]

Project Request: $PROJECT_REQ"

        RAW_PLAN=$(ollama run "$CHAT_MODEL" <<INSIDE_HEREDOC
$ARCH_PROMPT
INSIDE_HEREDOC
)

        CLEAN_JSON=$(echo "$RAW_PLAN" | perl -0777 -pe 's/<think>.*?<\/think>//gs; s/```json//g; s/```//g' | tr -d '\r')

        if ! echo "$CLEAN_JSON" | python3 -m json.tool >/dev/null 2>&1; then
            echo "Error: Architect failed to generate valid JSON plan."
            echo "Raw output was:"
            echo "$RAW_PLAN"
            exit 1
        fi

        FILE_COUNT=$(echo "$CLEAN_JSON" | python3 -c "import sys, json; print(len(json.load(sys.stdin)))")
        echo "Architect generated a $FILE_COUNT-file plan."

        echo -e "\n==================================================="
        echo " PHASE 2: Autonomous Code Building Loop (Model: $CHAT_MODEL)"
        echo -e "===================================================\n"

        ACCUMULATED_CONTEXT=""

        for (( i=0; i<$FILE_COUNT; i++ )); do
            FILE_PATH=$(echo "$CLEAN_JSON" | python3 -c "import sys, json; print(json.load(sys.stdin)[$i]['path'])")
            FILE_DESC=$(echo "$CLEAN_JSON" | python3 -c "import sys, json; print(json.load(sys.stdin)[$i]['description'])")

            echo "---------------------------------------------------"
            echo "Building [$((i+1))/$FILE_COUNT]: $FILE_PATH"
            echo "Purpose: $FILE_DESC"
            echo "---------------------------------------------------"

            mkdir -p "$(dirname "$FILE_PATH")"

            BUILD_PROMPT="You are a Senior Developer. Write ONLY the implementation for: $FILE_PATH

File Path: $FILE_PATH
Requirements: $FILE_DESC

Overall Project Request: $PROJECT_REQ

PREVIOUSLY GENERATED FILES IN THIS PROJECT:
${ACCUMULATED_CONTEXT:-None yet (this is the first file).}

CRITICAL INSTRUCTION:
Write ONLY the code for $FILE_PATH.
Wrap your entire code response inside <FILE_CONTENT> and </FILE_CONTENT> tags.

Rules:
1. CONFIG FILES ($FILE_PATH): Output ONLY variable exports. Do NOT write script logic or source statements inside config files.
2. RELATIVE PATHS: Use SCRIPT_DIR=\"\$(cd \"\$(dirname \"\${BASH_SOURCE[0]}\")\" && pwd)\" and relative paths (e.g., \$SCRIPT_DIR/../config/env.sh).
3. DIRECTORY INTEGRITY: Whenever writing to a file or database path defined in variables, explicitly ensure the target directory exists using 'mkdir -p \"\$(dirname \"\$TARGET_FILE\")\"' before performing write operations.
4. SAFE MATH & PARSING:
   - Perform percentage calculations directly inside AWK (e.g. awk '/MemTotal/ {t=\$2} /MemAvailable/ {a=\$2} END {printf \"%.2f\", (t-a)/t*100}' /proc/meminfo).
   - Do NOT pass raw AWK variables into 'bc' without fallback default values.
5. Do NOT repeat code from other files inside $FILE_PATH."

            FILE_CODE=$(ollama run "$CHAT_MODEL" <<INSIDE_HEREDOC
$BUILD_PROMPT
INSIDE_HEREDOC
)

            CLEAN_CODE=$(echo "$FILE_CODE" | perl -0777 -ne 'if (/<FILE_CONTENT>(.*?)<\/FILE_CONTENT>/s) { print $1; } else { print $_; }')
            CLEAN_CODE=$(echo "$CLEAN_CODE" | perl -0777 -pe 's/<think>.*?<\/think>//gs; s/```[a-zA-Z]*\n//g; s/```//g' | sed '/^[[:space:]]*$/d')

            echo "$CLEAN_CODE" > "$FILE_PATH"

            if [[ "$FILE_PATH" == *.sh ]] || [[ "$FILE_PATH" == bin/* ]] || head -n 1 "$FILE_PATH" | grep -q "^#!"; then
                chmod +x "$FILE_PATH"
            fi

            ACCUMULATED_CONTEXT="${ACCUMULATED_CONTEXT}
# --- START FILE: $FILE_PATH ---
$CLEAN_CODE
# --- END FILE: $FILE_PATH ---
"

            echo "Saved -> $FILE_PATH ($(wc -l < "$FILE_PATH") lines)"
        done

        echo -e "\n==================================================="
        echo " SUCCESS: Project build complete!"
        echo -e "===================================================\n"
        ;;

    -v|--version)
        echo "aicli version $VERSION"
        ;;

    -h|--help|"")
        show_help
        ;;

    *)
        echo "Error: Unknown subcommand '$SUBCOMMAND'"
        echo "Run 'aicli --help' for usage instructions."
        exit 1
        ;;
es:
