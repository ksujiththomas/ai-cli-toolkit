# ---------------------------------------------------------------------------
# Safety: never let the model write outside the current project directory.
# The architect phase emits file paths; a confused (or jailbroken) model could
# emit absolute paths or ".." segments. Reject anything that isn't a plain
# relative path and normalize the rest.
# ---------------------------------------------------------------------------
sanitize_relpath() {
    local raw="$1" part
    case "$raw" in
        ""|.) return 1 ;;   # empty path
        /*)   return 1 ;;   # absolute path - never allowed
    esac
    raw="${raw#./}"         # tolerate a leading ./
    local -a clean=()
    local IFS='/'
    read -r -a parts <<< "$raw"
    for part in "${parts[@]}"; do
        case "$part" in
            ""|"."|"..") return 1 ;;  # empty, current-dir or parent-dir segment
        esac
        clean+=("$part")
    done
    [ "${#clean[@]}" -eq 0 ] && return 1
    ( IFS='/'; printf '%s' "${clean[*]}" )
}

# Strip <think> blocks and markdown fences from model output.
strip_model_noise() {
    perl -0777 -pe 's/<think>.*?<\/think>//gs; s/```[a-zA-Z]*\s*\n?//g; s/```//g' | tr -d '\r'
}

# ---------------------------------------------------------------------------
# Agent mode: multi-model sandboxed autonomous loop.
#
# Three roles, each runnable on a different local model:
#   architect -> writes a step plan + machine-readable <DELIVERABLES> list
#   builder   -> ReAct loop with filesystem tools (read/write/ls/run/done),
#                steered by a live MISSING/done checklist injected every step
#   reviewer  -> critiques changed files against the checklist; sends the
#                builder back with file-specific notes
#
# The checklist is the core steering mechanism: small models wander without
# explicit state, so every builder prompt leads with TASK + DELIVERABLES +
# recent history (rolling window), and `done` is rejected while anything is
# still MISSING.
#
# Safety: every path is jailed to the project dir (sanitize_relpath), shell
# commands are denied by policy list and then run sandboxed (bwrap), confirmed
# interactively, or not at all (dry-run) depending on AGENT_MODE.
# ---------------------------------------------------------------------------

# Extract the first <TOOL>...</TOOL> block from stdin.
extract_tool_json() {
    perl -0777 -ne 'if (/<TOOL>(.*?)<\/TOOL>/s) { print $1; }'
}

# Extract the first <VERDICT>...</VERDICT> block from stdin.
extract_verdict_json() {
    perl -0777 -ne 'if (/<VERDICT>(.*?)<\/VERDICT>/s) { print $1; }'
}

# Parse a tool-call JSON doc from stdin.
# Prints three NUL-separated fields: tool name, first arg, second arg.
# Forgiving: if the whole block isn't valid JSON, falls back to the first
# {...} object found inside it (models often wrap JSON in prose).
parse_tool_call() {
    python3 -c '
import sys, json, re
raw = sys.stdin.read()
def emit(tool, a1, a2):
    sys.stdout.write("\x00".join([tool, a1, a2]))
d = None
try:
    d = json.loads(raw)
except Exception:
    m = re.search(r"\{.*\}", raw, re.S)
    if m:
        try:
            d = json.loads(m.group(0))
        except Exception:
            d = None
if d is None:
    emit("!parse-error", "", "")
    sys.exit(0)
tool = str(d.get("tool", ""))
a1 = a2 = ""
if tool in ("read", "ls"):
    a1 = str(d.get("path", ""))
elif tool == "write":
    a1 = str(d.get("path", ""))
    a2 = str(d.get("content", ""))
elif tool == "run":
    a1 = str(d.get("command", ""))
elif tool == "done":
    a1 = str(d.get("summary", ""))
emit(tool, a1, a2)
'
}

# Parse a reviewer verdict JSON doc from stdin -> "verdict\0notes".
parse_verdict() {
    python3 -c '
import sys, json
try:
    d = json.loads(sys.stdin.read())
except Exception:
    sys.stdout.write("!parse-error\x00")
    sys.exit(0)
sys.stdout.write(str(d.get("verdict", "")) + "\x00" + str(d.get("notes", "")))
'
}

# Parse the architect's <DELIVERABLES> JSON array from stdin.
# Prints "path|purpose" lines. Exit 1 = no block, 2 = invalid JSON.
parse_deliverables() {
    python3 -c '
import sys, json, re
raw = sys.stdin.read()
m = re.search(r"<DELIVERABLES>(.*?)</DELIVERABLES>", raw, re.S)
if not m:
    sys.exit(1)
try:
    items = json.loads(m.group(1))
except Exception:
    sys.exit(2)
for it in items:
    if not isinstance(it, dict):
        continue
    p = str(it.get("path", "")).strip()
    if p:
        print(p + "|" + str(it.get("purpose", "")).strip())
'
}

# Safety policy for the `run` tool: never allow these, even sandboxed.
agent_cmd_denied() {
    local lc
    lc="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    case "$lc" in
        *sudo*|*su\ -*|*su\ root*|*mkfs*|*"dd "*|*fdisk*|*shutdown*|*reboot*|*poweroff*|*halt*|*":(){"*|*rm\ -rf\ /*|*rm\ -rf\ ~*)
            return 0 ;;
    esac
    return 1
}

# Run a command inside a bubblewrap jail: project dir read-write, the base
# system read-only, no network, no home directory, nothing else visible.
agent_run_sandboxed() {
    local cmd="$1" proj="$2"
    local -a binds=()
    local d
    for d in /usr /bin /sbin /lib /lib64 /etc; do
        [ -e "$d" ] && binds+=(--ro-bind "$d" "$d")
    done
    printf '%s' "$cmd" | timeout "${AGENT_CMD_TIMEOUT:-60}" bwrap \
        --unshare-net --die-with-parent \
        "${binds[@]}" \
        --bind "$proj" "$proj" \
        --tmpfs /tmp --proc /proc --dev /dev \
        --chdir "$proj" \
        --setenv PATH /usr/local/bin:/usr/bin:/bin \
        --setenv HOME /tmp \
        bash -s 2>&1
}

# Run a command only after the user approves it interactively.
agent_run_confirmed() {
    local cmd="$1" ans=""
    echo "Agent wants to run:"
    echo "  $cmd"
    read -r -p "Allow this command? (y/N): " ans || ans=""
    case "$ans" in
        y|Y) timeout "${AGENT_CMD_TIMEOUT:-60}" bash -c "$cmd" 2>&1 ;;
        *)   echo "[denied by user]" ;;
    esac
}

# aicli agent [--flags] "task description"
cmd_agent() {
    local ARCH_M="$ARCHITECT_MODEL" BUILD_M="$BUILDER_MODEL" REV_M="$REVIEWER_MODEL"
    local MODE="$AGENT_MODE" MAX_STEPS="$AGENT_MAX_STEPS" MAX_REV="$AGENT_MAX_REVISIONS"
    local OUT_CHARS="$AGENT_MAX_OUTPUT_CHARS" MODEL_TIMEOUT="$AGENT_MODEL_TIMEOUT"
    local HIST_KEPT="$AGENT_HISTORY_KEPT"
    local DO_REVIEW=1
    local NL=$'\n'

    local -a CHANGED=() HIST=()
    local -a DELIV_PATHS=() DELIV_PURPOSE=() DELIV_DONE=()
    local step=0 rev=0 finished=0 notool_streak=0 done_reject_streak=0
    local LAST_WHASH="" SAME_WRITE_COUNT=0
    local tool_result="" prev_sig=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --architect-model)
                [ $# -ge 2 ] || { echo "Flag --architect-model needs a value." >&2; return 1; }
                ARCH_M="$2"; shift 2 ;;
            --builder-model)
                [ $# -ge 2 ] || { echo "Flag --builder-model needs a value." >&2; return 1; }
                BUILD_M="$2"; shift 2 ;;
            --reviewer-model)
                [ $# -ge 2 ] || { echo "Flag --reviewer-model needs a value." >&2; return 1; }
                REV_M="$2"; shift 2 ;;
            --mode)
                [ $# -ge 2 ] || { echo "Flag --mode needs a value." >&2; return 1; }
                MODE="$2"; shift 2 ;;
            --max-steps)
                [ $# -ge 2 ] || { echo "Flag --max-steps needs a value." >&2; return 1; }
                MAX_STEPS="$2"; shift 2 ;;
            --max-revisions)
                [ $# -ge 2 ] || { echo "Flag --max-revisions needs a value." >&2; return 1; }
                MAX_REV="$2"; shift 2 ;;
            --no-review) DO_REVIEW=0; shift ;;
            --) shift; break ;;
            -*) echo "Unknown agent flag: $1" >&2; return 1 ;;
            *) break ;;
        esac
    done

    local TASK="$*"
    if [ -z "$TASK" ]; then
        echo "Usage: aicli agent [flags] \"task description\"" >&2
        echo "Flags: --architect-model M --builder-model M --reviewer-model M" >&2
        echo "       --mode sandbox|confirm|dry-run" >&2
        echo "       --max-steps N --max-revisions N --no-review" >&2
        return 1
    fi

    case "$MODE" in
        sandbox|confirm|dry-run) ;;
        *) echo "Error: --mode must be sandbox, confirm, or dry-run." >&2; return 1 ;;
    esac
    [[ "$MAX_STEPS" =~ ^[1-9][0-9]*$ ]] || { echo "Error: --max-steps must be a positive integer." >&2; return 1; }
    [[ "$MAX_REV" =~ ^[0-9]+$ ]] || { echo "Error: --max-revisions must be a non-negative integer." >&2; return 1; }

    local m
    for m in "$ARCH_M" "$BUILD_M"; do
        if ! ollama list | awk 'NR>1 {print $1}' | grep -qxF -- "$m"; then
            echo "Error: model '$m' is not downloaded. Pull it first: ollama pull $m" >&2
            return 1
        fi
    done
    if [ "$DO_REVIEW" -eq 1 ] && ! ollama list | awk 'NR>1 {print $1}' | grep -qxF -- "$REV_M"; then
        echo "Error: reviewer model '$REV_M' is not downloaded. Pull it first, or pass --no-review." >&2
        return 1
    fi

    if [ "$MODE" = "sandbox" ] && ! command -v bwrap >/dev/null 2>&1; then
        echo "Warning: 'bwrap' not found; sandbox mode unavailable. Falling back to confirm mode." >&2
        MODE="confirm"
    fi

    # The agent's whole world: everything it reads/writes happens under here.
    local PROJ="$PWD"

    # ---- Small helpers, defined here so they see cmd_agent's locals ----
    # (bash uses dynamic scoping: functions called from inside cmd_agent
    # can read its local variables).
    agent_deliv_status() {
        local i
        if [ "${#DELIV_PATHS[@]}" -eq 0 ]; then
            printf '  (no deliverables list; use your best judgment)\n'
            return
        fi
        for i in "${!DELIV_PATHS[@]}"; do
            if [ "${DELIV_DONE[$i]}" = "1" ]; then
                printf '  [done] %s\n' "${DELIV_PATHS[$i]}"
            else
                printf '  [MISSING] %s -- %s\n' "${DELIV_PATHS[$i]}" "${DELIV_PURPOSE[$i]}"
            fi
        done
    }
    agent_deliv_missing() {
        local i
        for i in "${!DELIV_PATHS[@]}"; do
            if [ "${DELIV_DONE[$i]}" != "1" ]; then
                printf '%s\n' "${DELIV_PATHS[$i]}"
            fi
        done
    }
    agent_mark_done() {
        local target="$1" i
        for i in "${!DELIV_PATHS[@]}"; do
            if [ "${DELIV_PATHS[$i]}" = "$target" ]; then
                DELIV_DONE[$i]=1
            fi
        done
    }
    agent_render_history() {
        local n=${#HIST[@]} start=0 i
        if [ "$n" -gt "$HIST_KEPT" ]; then start=$((n - HIST_KEPT)); fi
        for ((i = start; i < n; i++)); do
            printf '%s\n' "${HIST[$i]}"
        done
    }
    agent_render_prompt() {
        # $1 = last tool result (may be empty)
        local p="$SYS"
        p+="${NL}${NL}TASK: ${TASK}"
        p+="${NL}${NL}DELIVERABLES (create every MISSING one):${NL}$(agent_deliv_status)"
        p+="${NL}${NL}PLAN:${NL}${PLAN}"
        p+="${NL}${NL}RECENT HISTORY (most recent last):${NL}$(agent_render_history)"
        if [ -n "$1" ]; then
            p+="${NL}${NL}LAST TOOL RESULT:${NL}$1"
        fi
        p+="${NL}${NL}Reply with exactly one <TOOL> block first."
        printf '%s' "$p"
    }
    # Fingerprint of current outputs: detects revision rounds with no progress.
    agent_state_sig() {
        local f
        for f in "${CHANGED[@]}"; do
            if [ -f "$PROJ/$f" ]; then
                printf '%s:%s\n' "$f" "$(cksum < "$PROJ/$f" | cut -d' ' -f1)"
            else
                printf '%s:gone\n' "$f"
            fi
        done | sort
    }

    # ---- Phase 1: architect plans + deliverables ----
    echo "AGENT phase 1/3: architect ($ARCH_M) planning..."
    local PLAN_RAW
    PLAN_RAW="$(timeout "$MODEL_TIMEOUT" ollama run "$ARCH_M" <<< "[ROLE:ARCHITECT]
You are a software architect. Your reply has TWO parts.

PART 1 - deliverables. List every file this task requires (new files to create
and existing files to modify) as a JSON array inside <DELIVERABLES> tags.
Paths are relative to the project root, never absolute, never containing '..'.
Example:
<DELIVERABLES>[{\"path\": \"index.html\", \"purpose\": \"page structure\"}, {\"path\": \"styles.css\", \"purpose\": \"styling\"}]</DELIVERABLES>

PART 2 - plan. After the tags, a short numbered plan (5-10 concrete steps).

Task: $TASK")" || PLAN_RAW=""

    if [ -n "$PLAN_RAW" ]; then
        local DLV_RAW
        if DLV_RAW="$(printf '%s' "$PLAN_RAW" | parse_deliverables)"; then
            local -a DLV=()
            mapfile -t DLV <<< "$DLV_RAW"
            local dl dp
            for dl in "${DLV[@]}"; do
                dp="${dl%%|*}"
                if dp="$(sanitize_relpath "$dp")"; then
                    DELIV_PATHS+=("$dp")
                    DELIV_PURPOSE+=("${dl#*|}")
                    DELIV_DONE+=(0)
                fi
            done
        fi
    fi
    if [ "${#DELIV_PATHS[@]}" -eq 0 ]; then
        echo "AGENT warning: architect produced no usable deliverables list; the done-gate is disabled for this run." >&2
    fi
    local PLAN
    PLAN="$(printf '%s' "$PLAN_RAW" | perl -0777 -pe 's/<DELIVERABLES>.*?<\/DELIVERABLES>//s')"
    [ -z "$PLAN" ] && PLAN="$PLAN_RAW"
    echo "$PLAN"
    echo

    # ---- Phases 2+3: builder loop, with reviewer passes ----
    local SYS
    SYS="$(cat <<'SYS_EOF'
[ROLE:BUILDER]
You are an autonomous coding agent. Your working directory IS the project root.

You MUST produce every file in the DELIVERABLES list. Do not stop until each
one exists and is complete. Never rewrite the same file repeatedly - once a
file is written, move on to the next MISSING deliverable.

TOOLS - reply with EXACTLY ONE tool call per message. Put the <TOOL> block
FIRST; short text after it is allowed but the block must come first:
<TOOL>{"tool": "read", "path": "relative/path"}</TOOL>                    read a file
<TOOL>{"tool": "write", "path": "relative/path", "content": "..."}</TOOL>   create/overwrite a whole file
<TOOL>{"tool": "ls", "path": "relative/dir"}</TOOL>                       list a directory
<TOOL>{"tool": "run", "command": "shell command"}</TOOL>                   run a shell command
<TOOL>{"tool": "done", "summary": "..."}</TOOL>                            finish (only when ALL deliverables exist)

RULES:
- Paths are relative to the project root. NEVER absolute, NEVER "..".
- "content" is a JSON string: escape newlines as \n and quotes as \".
- Sensible order: ls/read to inspect, write each deliverable ONCE, run to verify, then done.
- Shell commands are restricted and non-interactive; keep them simple.

EXAMPLE:
<TOOL>{"tool": "write", "path": "hello.sh", "content": "#!/bin/bash\necho hi\n"}</TOOL>
SYS_EOF
)"

    echo "AGENT phase 2/3: builder ($BUILD_M) working (mode=$MODE, max_steps=$MAX_STEPS)..."

    while [ "$finished" -eq 0 ]; do
        local done_flag=0
        while [ "$step" -lt "$MAX_STEPS" ] && [ "$done_flag" -eq 0 ]; do
            step=$((step + 1))
            echo "--- step $step/$MAX_STEPS ---"
            local response="" tool_json="" tool="(none)" a1="" a2=""
            response="$(timeout "$MODEL_TIMEOUT" ollama run "$BUILD_M" <<< "$(agent_render_prompt "$tool_result")")" || response=""

            if [ -n "$response" ]; then
                tool_json="$(printf '%s' "$response" | extract_tool_json)"
            fi

            if [ -z "$tool_json" ]; then
                notool_streak=$((notool_streak + 1))
                if [ "$notool_streak" -ge 3 ]; then
                    echo "AGENT: model ignored the tool protocol 3 times in a row - aborting." >&2
                    echo "AGENT: tip: agent mode works much better with a larger model (e.g. qwen2.5-coder:14b or 32b)." >&2
                    finished=1
                    break
                fi
                tool_result="No <TOOL> block found. Your reply MUST begin with exactly one tool call. Copy this template and fill it in:${NL}<TOOL>{\"tool\": \"write\", \"path\": \"relative/file\", \"content\": \"...\"}</TOOL>"
            else
                notool_streak=0
                local -a F=()
                mapfile -d '' -t F < <(printf '%s' "$tool_json" | parse_tool_call)
                tool="${F[0]:-}"
                # A non-done tool call breaks a streak of rejected dones.
                if [ "$tool" != "done" ]; then done_reject_streak=0; fi
                a1="${F[1]:-}"
                a2="${F[2]:-}"
                local sp="" out="" rc=0
                printf '  > %s %s\n' "$tool" "$(printf '%s' "$a1" | head -c 80)"
                case "$tool" in
                    '!parse-error')
                        tool_result="That was not valid JSON, and no JSON object could be recovered from it. Emit clean JSON inside the <TOOL> block." ;;
                    read)
                        if sp="$(sanitize_relpath "$a1")"; then
                            if [ -f "$PROJ/$sp" ]; then
                                tool_result="$(cat "$PROJ/$sp")"
                            else
                                tool_result="ERROR: file not found: $sp"
                            fi
                        else
                            tool_result="ERROR: path rejected (must be relative, no ..): $a1"
                        fi ;;
                    ls)
                        if [ "$a1" = "." ] || [ "$a1" = "./" ] || [ -z "$a1" ]; then
                            sp="."
                        else
                            sp="$(sanitize_relpath "$a1")" || sp=""
                        fi
                        if [ -n "$sp" ] && [ -d "$PROJ/$sp" ]; then
                            tool_result="$(ls -la "$PROJ/$sp")"
                        else
                            tool_result="ERROR: not a directory or path rejected: $a1"
                        fi ;;
                    write)
                        if sp="$(sanitize_relpath "$a1")"; then
                            local whash
                            whash="$(printf '%s' "$sp:$a2" | cksum | cut -d' ' -f1)"
                            if [ "$whash" = "$LAST_WHASH" ]; then
                                SAME_WRITE_COUNT=$((SAME_WRITE_COUNT + 1))
                            else
                                SAME_WRITE_COUNT=0
                            fi
                            LAST_WHASH="$whash"
                            if [ "$SAME_WRITE_COUNT" -ge 2 ]; then
                                tool_result="STOP: you have written identical content to $sp three times in a row. It is finished. Work on the MISSING deliverables next."
                                SAME_WRITE_COUNT=0
                            elif [ "$MODE" = "dry-run" ]; then
                                tool_result="dry-run: would write ${#a2} chars to: $sp (not executed)"
                                agent_mark_done "$sp"  # pretend success so the checklist advances
                            else
                                mkdir -p "$PROJ/$(dirname "$sp")"
                                printf '%s\n' "$a2" > "$PROJ/$sp"
                                CHANGED+=("$sp")
                                agent_mark_done "$sp"
                                tool_result="wrote $sp"
                            fi
                        else
                            tool_result="ERROR: path rejected (must be relative, no ..): $a1"
                        fi ;;
                    run)
                        if agent_cmd_denied "$a1"; then
                            tool_result="ERROR: command denied by safety policy."
                        elif [ "$MODE" = "dry-run" ]; then
                            tool_result="dry-run: would run: $a1 (not executed)"
                        elif [ "$MODE" = "sandbox" ]; then
                            out="$(agent_run_sandboxed "$a1" "$PROJ")"; rc=$?
                            tool_result="[exit $rc]${NL}$out"
                        else
                            out="$(agent_run_confirmed "$a1")"; rc=$?
                            tool_result="[exit $rc]${NL}$out"
                        fi ;;
                    done)
                        local missing
                        missing="$(agent_deliv_missing)"
                        if [ -n "$missing" ]; then
                            done_reject_streak=$((done_reject_streak + 1))
                            if [ "$done_reject_streak" -ge 3 ]; then
                                echo "AGENT: done rejected 3 times in a row with missing deliverables - aborting." >&2
                                echo "AGENT: tip: agent mode works much better with a larger model (e.g. qwen2.5-coder:14b or 32b)." >&2
                                finished=1
                                break
                            fi
                            tool_result="done REJECTED - these deliverables are still missing:${NL}${missing}${NL}Create them before calling done."
                        else
                            echo "AGENT: builder finished: $a1"
                            done_flag=1
                            break
                        fi ;;
                    *)
                        tool_result="ERROR: unknown tool '$tool'. Available: read, write, ls, run, done." ;;
                esac
                # Cap giant outputs so history can't blow the context window.
                tool_result="$(printf '%s' "$tool_result" | head -c "$OUT_CHARS")"
                printf '  < %s\n' "$(printf '%s' "$tool_result" | head -n 1 | head -c 160)"
            fi

            HIST+=("tool: $tool ${a1:0:60} => $(printf '%s' "$tool_result" | head -n 1 | head -c 120)")
        done

        if [ "$step" -ge "$MAX_STEPS" ] && [ "$done_flag" -eq 0 ]; then
            echo "AGENT: max steps reached."
        fi

        # Zero-progress detection: a revision round that changed nothing ends the run.
        local cur_sig
        cur_sig="$(agent_state_sig)"
        if [ -n "$prev_sig" ] && [ "$cur_sig" = "$prev_sig" ] && [ "$rev" -gt 0 ]; then
            echo "AGENT: revision round produced no changes; accepting current state."
            finished=1
            break
        fi
        prev_sig="$cur_sig"

        # ---- Phase 3: reviewer ----
        if [ "$DO_REVIEW" -eq 0 ] || [ "$finished" -eq 1 ]; then
            finished=1
            break
        fi
        if [ "$rev" -ge "$MAX_REV" ]; then
            echo "AGENT: max revisions reached; accepting current state."
            finished=1
            break
        fi
        rev=$((rev + 1))
        echo "AGENT phase 3/3: reviewer ($REV_M) pass $rev/$MAX_REV..."

        local REV_PROMPT="[ROLE:REVIEWER]
You are a senior code reviewer. Below: the task, the required deliverables and
their status, and the current content of each changed file.
Check every deliverable: does the file exist? Is it complete, or a skeleton of
comments and placeholders? Does it fulfill its stated purpose? Any bugs?

Respond with EXACTLY one verdict block and nothing else:
<VERDICT>{\"verdict\": \"approve\"}</VERDICT>
or
<VERDICT>{\"verdict\": \"revise\", \"notes\": \"file-specific issues, e.g. 'styles.css is missing; app.js: mobile nav toggle not implemented'\"}</VERDICT>

Task: $TASK

Deliverables:
$(agent_deliv_status)"
        local f
        for f in "${CHANGED[@]}"; do
            REV_PROMPT="${REV_PROMPT}${NL}--- file: $f ---${NL}$(head -c "$OUT_CHARS" "$PROJ/$f")"
        done

        local vresp vjson verdict="approve" notes=""
        vresp="$(timeout "$MODEL_TIMEOUT" ollama run "$REV_M" <<< "$REV_PROMPT")" || vresp=""
        vjson="$(printf '%s' "$vresp" | extract_verdict_json)"
        if [ -n "$vjson" ]; then
            local -a V=()
            mapfile -d '' -t V < <(printf '%s' "$vjson" | parse_verdict)
            verdict="${V[0]:-approve}"
            notes="${V[1]:-}"
        else
            echo "AGENT: reviewer gave no verdict block; accepting with warning."
        fi

        if [ "$verdict" = "approve" ]; then
            echo "AGENT: reviewer approved."
            finished=1
        elif [ "$verdict" = "revise" ]; then
            echo "AGENT: reviewer requested revisions; builder continues."
            tool_result="Reviewer feedback (pass $rev):${NL}${notes}${NL}Address every point above, then call done again."
            HIST+=("reviewer (pass $rev): requested revisions")
        else
            echo "AGENT: unclear reviewer verdict ('$verdict'); accepting."
            finished=1
        fi
    done

    local missing_count
    missing_count="$(agent_deliv_missing | wc -l)"
    echo
    echo "AGENT: run complete ($step steps, ${#CHANGED[@]} files changed, $missing_count deliverables missing)."
}

# ---------------------------------------------------------------------------
# Subcommand parsing
# ---------------------------------------------------------------------------
SUBCOMMAND="${1:-}"
if [ $# -gt 0 ]; then shift; fi

case "$SUBCOMMAND" in
    model|-m)
        NEW_MODEL="${1:-}"
        if [ -z "$NEW_MODEL" ]; then
            echo "==================================================="
            echo " Active Ollama Model: ${CHAT_MODEL:-qwen2.5-coder:7b}"
            echo "==================================================="
            echo -e "\nAvailable Local Models (Ollama):"
            ollama list | awk 'NR>1 {print "  - " $1}'
            echo -e "\nTo switch models, run:"
            echo "  aicli model <model_name>"
            exit 0
        fi

        # Exact match against the downloaded model names.
        if ! ollama list | awk 'NR>1 {print $1}' | grep -qxF -- "$NEW_MODEL"; then
            echo "Warning: Model '$NEW_MODEL' is not currently downloaded in Ollama."
            choice=""
            read -r -p "Do you want to pull '$NEW_MODEL' now? (y/N): " choice
            case "$choice" in
                y|Y)
                    ollama pull "$NEW_MODEL"
                    ;;
                *)
                    echo "Aborted model change."
                    exit 1
                    ;;
            esac
        fi

        save_config "CHAT_MODEL" "$NEW_MODEL"
        echo "Active model updated to: $NEW_MODEL"
        ;;

    config|-c)
        KEY="${1:-}"
        VALUE="${2:-}"
        if [ -z "$KEY" ]; then
            echo "Current aicli settings ($CONFIG_FILE):"
            echo "  CHAT_MODEL=\"$CHAT_MODEL\""
            echo "  CONTEXT_WINDOW_FILES=\"$CONTEXT_WINDOW_FILES\""
            echo "  ARCHITECT_MODEL=\"$ARCHITECT_MODEL\""
            echo "  BUILDER_MODEL=\"$BUILDER_MODEL\""
            echo "  REVIEWER_MODEL=\"$REVIEWER_MODEL\""
            echo "  AGENT_MODE=\"$AGENT_MODE\""
            echo "  AGENT_MAX_STEPS=\"$AGENT_MAX_STEPS\""
            echo "  AGENT_MAX_REVISIONS=\"$AGENT_MAX_REVISIONS\""
            echo "  AGENT_MAX_OUTPUT_CHARS=\"$AGENT_MAX_OUTPUT_CHARS\""
            echo "  AGENT_CMD_TIMEOUT=\"$AGENT_CMD_TIMEOUT\""
            echo "  AGENT_MODEL_TIMEOUT=\"$AGENT_MODEL_TIMEOUT\""
            echo "  AGENT_HISTORY_KEPT=\"$AGENT_HISTORY_KEPT\""
            echo
            echo "Change one with: aicli config <key> <value>"
            exit 0
        fi
        case "$KEY" in
            CHAT_MODEL)
                [ -z "$VALUE" ] && { echo "Usage: aicli config CHAT_MODEL <model_name>" >&2; exit 1; }
                save_config "CHAT_MODEL" "$VALUE"
                echo "CHAT_MODEL updated to: $VALUE"
                ;;
            CONTEXT_WINDOW_FILES|context-window)
                [[ "$VALUE" =~ ^[1-9][0-9]*$ ]] || { echo "Usage: aicli config context-window <positive integer>" >&2; exit 1; }
                save_config "CONTEXT_WINDOW_FILES" "$VALUE"
                echo "CONTEXT_WINDOW_FILES updated to: $VALUE"
                ;;
            ARCHITECT_MODEL|architect-model)
                [ -z "$VALUE" ] && { echo "Usage: aicli config architect-model <model_name>" >&2; exit 1; }
                save_config "ARCHITECT_MODEL" "$VALUE"
                echo "ARCHITECT_MODEL updated to: $VALUE"
                ;;
            BUILDER_MODEL|builder-model)
                [ -z "$VALUE" ] && { echo "Usage: aicli config builder-model <model_name>" >&2; exit 1; }
                save_config "BUILDER_MODEL" "$VALUE"
                echo "BUILDER_MODEL updated to: $VALUE"
                ;;
            REVIEWER_MODEL|reviewer-model)
                [ -z "$VALUE" ] && { echo "Usage: aicli config reviewer-model <model_name>" >&2; exit 1; }
                save_config "REVIEWER_MODEL" "$VALUE"
                echo "REVIEWER_MODEL updated to: $VALUE"
                ;;
            AGENT_MODE|agent-mode)
                case "$VALUE" in
                    sandbox|confirm|dry-run) ;;
                    *) echo "Usage: aicli config agent-mode <sandbox|confirm|dry-run>" >&2; exit 1 ;;
                esac
                save_config "AGENT_MODE" "$VALUE"
                echo "AGENT_MODE updated to: $VALUE"
                ;;
            AGENT_MAX_STEPS|max-steps|AGENT_MAX_REVISIONS|max-revisions|AGENT_MAX_OUTPUT_CHARS|max-output-chars|AGENT_CMD_TIMEOUT|cmd-timeout|AGENT_MODEL_TIMEOUT|model-timeout|AGENT_HISTORY_KEPT|history-kept)
                [[ "$VALUE" =~ ^[1-9][0-9]*$ ]] || { echo "Usage: aicli config $KEY <positive integer>" >&2; exit 1; }
                # Normalize the dashed alias to the canonical KEY name.
                case "$KEY" in
                    max-steps) KEY="AGENT_MAX_STEPS" ;;
                    max-revisions) KEY="AGENT_MAX_REVISIONS" ;;
                    max-output-chars) KEY="AGENT_MAX_OUTPUT_CHARS" ;;
                    cmd-timeout) KEY="AGENT_CMD_TIMEOUT" ;;
                    model-timeout) KEY="AGENT_MODEL_TIMEOUT" ;;
                    history-kept) KEY="AGENT_HISTORY_KEPT" ;;
                esac
                save_config "$KEY" "$VALUE"
                echo "$KEY updated to: $VALUE"
                ;;
            *)
                echo "Error: unknown setting '$KEY'. Known settings:" >&2
                echo "  CHAT_MODEL, CONTEXT_WINDOW_FILES, ARCHITECT_MODEL, BUILDER_MODEL," >&2
                echo "  REVIEWER_MODEL, AGENT_MODE, AGENT_MAX_STEPS, AGENT_MAX_REVISIONS," >&2
                echo "  AGENT_MAX_OUTPUT_CHARS, AGENT_CMD_TIMEOUT, AGENT_MODEL_TIMEOUT," >&2
                echo "  AGENT_HISTORY_KEPT" >&2
                exit 1
                ;;
        esac
        ;;

    ask|-a)
        PROMPT="$*"
        if [ -z "$PROMPT" ]; then
            echo "Usage: aicli ask \"Your question or request\"" >&2
            exit 1
        fi
        ollama run "$CHAT_MODEL" "$PROMPT"
        ;;

    arch|-r)
        PROMPT="$*"
        if [ -z "$PROMPT" ]; then
            echo "Usage: aicli arch \"Describe the system architecture to design\"" >&2
            exit 1
        fi
        ARCH_PROMPT="You are a Principal Software Architect.
Provide a high-level system architectural blueprint, component design, and a JSON file tree.

Project Request: $PROMPT"
        # Feed the prompt via stdin (<<<) rather than an unquoted heredoc so
        # model output interpolated into later prompts can never be
        # re-expanded as shell code.
        ollama run "$CHAT_MODEL" <<< "$ARCH_PROMPT"
        ;;

    build|-b)
        PROJECT_REQ="$*"
        if [ -z "$PROJECT_REQ" ]; then
            echo "Usage: aicli build \"Describe the project you want to auto-build\"" >&2
            exit 1
        fi

        echo -e "\n==================================================="
        echo " PHASE 1: Architecting System & File Tree (Model: $CHAT_MODEL)"
        echo -e "===================================================\n"

        BASE_ARCH_PROMPT="You are a Lead Software Architect.
Decompose this project into discrete, modular code files.
OUTPUT ONLY VALID JSON raw array with no markdown formatting or extra text.

JSON Format:
[
  {
    \"path\": \"relative/file/path.ext\",
    \"description\": \"Specific purpose of this file and precise implementation requirements.\"
  }
]

Rules for paths:
- Every path MUST be relative to the project root (e.g. \"src/main.py\").
- NEVER use absolute paths and NEVER use \"..\" segments.

Project Request: $PROJECT_REQ"

        STRICT_ARCH_PROMPT="$BASE_ARCH_PROMPT

STRICT OUTPUT REQUIREMENT: Your previous response was not valid JSON.
Respond now with ONLY the raw JSON array. No prose, no markdown fences, no <think> blocks."

        ARCH_PROMPT="$BASE_ARCH_PROMPT"
        PLAN_ATTEMPTS=0
        MAX_PLAN_ATTEMPTS=3
        CLEAN_JSON=""
        while :; do
            RAW_PLAN="$(ollama run "$CHAT_MODEL" <<< "$ARCH_PROMPT")"
            CLEAN_JSON="$(printf '%s' "$RAW_PLAN" | strip_model_noise)"

            if printf '%s' "$CLEAN_JSON" | python3 -m json.tool >/dev/null 2>&1; then
                break
            fi

            PLAN_ATTEMPTS=$((PLAN_ATTEMPTS + 1))
            if [ "$PLAN_ATTEMPTS" -ge "$MAX_PLAN_ATTEMPTS" ]; then
                echo "Error: Architect failed to generate a valid JSON plan after $MAX_PLAN_ATTEMPTS attempts."
                echo "Last raw output was:"
                echo "$RAW_PLAN"
                exit 1
            fi
            echo "Architect output was not valid JSON - retrying ($PLAN_ATTEMPTS/$MAX_PLAN_ATTEMPTS) with stricter instructions..."
            ARCH_PROMPT="$STRICT_ARCH_PROMPT"
        done

        # Parse the plan ONCE into bash arrays (NUL-delimited so that
        # multi-line descriptions stay aligned with their paths).
        mapfile -d '' -t FILE_PATHS < <(printf '%s' "$CLEAN_JSON" | python3 -c \
            'import sys, json; [sys.stdout.write(str(x.get("path", "")) + "\x00") for x in json.load(sys.stdin)]')
        mapfile -d '' -t FILE_DESCS < <(printf '%s' "$CLEAN_JSON" | python3 -c \
            'import sys, json; [sys.stdout.write(str(x.get("description", "")) + "\x00") for x in json.load(sys.stdin)]')

        FILE_COUNT="${#FILE_PATHS[@]}"
        if [ "$FILE_COUNT" -eq 0 ]; then
            echo "Error: Architect returned an empty file plan." >&2
            exit 1
        fi
        echo "Architect generated a $FILE_COUNT-file plan."

        echo -e "\n==================================================="
        echo " PHASE 2: Autonomous Code Building Loop (Model: $CHAT_MODEL)"
        echo -e "===================================================\n"

        # Cumulative context memory: every generated file is appended here so
        # later files stay consistent (imports, paths, shared config keys).
        # Only the most recent CONTEXT_WINDOW_FILES are fed back, to keep the
        # prompt inside the model's context window on large projects.
        declare -a CONTEXT_BLOCKS=()

        build_context() {
            local total="${#CONTEXT_BLOCKS[@]}" start=0 j out=""
            if [ "$total" -gt "$CONTEXT_WINDOW_FILES" ]; then
                start=$((total - CONTEXT_WINDOW_FILES))
            fi
            for (( j = start; j < total; j++ )); do
                out+="${CONTEXT_BLOCKS[j]}"$'\n'
            done
            printf '%s' "$out"
        }

        for (( i = 0; i < FILE_COUNT; i++ )); do
            RAW_PATH="${FILE_PATHS[$i]}"
            FILE_DESC="${FILE_DESCS[$i]}"

            # Security gate: refuse absolute paths and ".." escapes.
            if ! SAFE_PATH="$(sanitize_relpath "$RAW_PATH")"; then
                echo "Error: architect returned an unsafe file path ('$RAW_PATH')." >&2
                echo "Paths must be relative to the project root with no '..' segments. Aborting." >&2
                exit 1
            fi

            echo "---------------------------------------------------"
            echo "Building [$((i + 1))/$FILE_COUNT]: $SAFE_PATH"
            echo "Purpose: $FILE_DESC"
            echo "---------------------------------------------------"

            mkdir -p "$(dirname "$SAFE_PATH")"

            CONTEXT_TEXT="$(build_context)"
            if [ -z "$CONTEXT_TEXT" ]; then
                CONTEXT_TEXT="None yet (this is the first file)."
            fi

            BUILD_PROMPT="You are a Senior Developer. Write ONLY the implementation for: $SAFE_PATH

File Path: $SAFE_PATH
Requirements: $FILE_DESC

Overall Project Request: $PROJECT_REQ

PREVIOUSLY GENERATED FILES IN THIS PROJECT (most recent $CONTEXT_WINDOW_FILES shown):
$CONTEXT_TEXT

CRITICAL INSTRUCTION:
Write ONLY the code for $SAFE_PATH.
Wrap your entire code response inside <FILE_CONTENT> and </FILE_CONTENT> tags.

Rules:
1. CONFIG FILES ($SAFE_PATH): Output ONLY variable exports. Do NOT write script logic or source statements inside config files.
2. PATH RESOLUTION & SOURCING:
   - Always initialize SCRIPT_DIR: SCRIPT_DIR=\"\$(cd \"\$(dirname \"\${BASH_SOURCE[0]}\")\" && pwd)\"
   - For files located inside subdirectories like 'bin/', always source other modules relative to the project root using '..', e.g., source \"\$SCRIPT_DIR/../config/settings.conf\" and source \"\$SCRIPT_DIR/../lib/module.sh\". Never assume a flat execution context.
3. DIRECTORY INTEGRITY: Whenever writing to a file or database path defined in variables, explicitly ensure the target directory exists using 'mkdir -p \"\$(dirname \"\$TARGET_FILE\")\"' before performing write operations.
4. SAFE MATH & PARSING:
   - Perform percentage calculations directly inside AWK (e.g. awk '/MemTotal/ {t=\$2} /MemAvailable/ {a=\$2} END {printf \"%.2f\", (t-a)/t*100}' /proc/meminfo).
   - Do NOT pass raw AWK variables into 'bc' without fallback default values.
5. Do NOT repeat code from other files inside $SAFE_PATH."

            # Note: prompts go in via <<< so embedded model output is never
            # re-expanded by the shell (prevents $(...) injection).
            FILE_CODE="$(ollama run "$CHAT_MODEL" <<< "$BUILD_PROMPT")"

            CLEAN_CODE="$(printf '%s' "$FILE_CODE" | perl -0777 -ne 'if (/<FILE_CONTENT>(.*?)<\/FILE_CONTENT>/s) { print $1; } else { print $_; }' | strip_model_noise)"

            printf '%s\n' "$CLEAN_CODE" > "$SAFE_PATH"

            if [[ "$SAFE_PATH" == *.sh ]] || [[ "$SAFE_PATH" == bin/* ]] || head -n 1 "$SAFE_PATH" | grep -q '^#!'; then
                chmod +x "$SAFE_PATH"
            fi

            CONTEXT_BLOCKS+=("$(printf '# --- START FILE: %s ---\n%s\n# --- END FILE: %s ---\n' "$SAFE_PATH" "$CLEAN_CODE" "$SAFE_PATH")")

            echo "Saved -> $SAFE_PATH ($(wc -l < "$SAFE_PATH") lines)"
        done

        echo -e "\n==================================================="
        echo " SUCCESS: Project build complete!"
        echo -e "===================================================\n"
        ;;

    agent)
        cmd_agent "$@"
        ;;

    -v|--version)
        echo "aicli version $VERSION"
        ;;

    -h|--help|"")
        show_help
        ;;

    *)
        echo "Error: Unknown subcommand '$SUBCOMMAND'" >&2
        echo "Run 'aicli --help' for usage instructions." >&2
        exit 1
        ;;
esac
