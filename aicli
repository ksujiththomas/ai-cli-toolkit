    local _pmodesuffix=""
    [ "$PROJECT" -eq 1 ] && _pmodesuffix+=", project mode"
    [ "$THOROUGH" -eq 1 ] && _pmodesuffix+=", thorough"
    echo "AGENT phase 2/3: builder ($BUILD_M) working (mode=$MODE, max_steps=$MAX_STEPS$_pmodesuffix)..."

    # ---- timing state ----
    local -a STEP_TIMES=()   # "secs|step|tool|arg"
    local -a SECT_TIMES=()   # "secs|path -- section"
    declare -A SECT_START=() # "path::section" -> $SECONDS at first write
    local T_BUILD_START=$SECONDS T_BUILD_END=0 T_REV_START=0 T_REV_END=0

    while [ "$finished" -eq 0 ]; do
        local done_flag=0
        while [ "$step" -lt "$MAX_STEPS" ] && [ "$done_flag" -eq 0 ]; do
            step=$((step + 1))
            local _secinfo=""
            if [ "$PROJECT" -eq 1 ] && [ -f "$PROJ/.aicli/progress.md" ]; then
                local _t _d
