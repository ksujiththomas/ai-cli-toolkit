# ---------------------------------------------------------------------------
# Safety: never let the model write outside the current project directory.
# The architect phase emits file paths; a confused (or jailbroken) model could
# emit absolute paths or ".." segments. Reject anything that isn't a plain
# relative path and normalize the rest.
# ---------------------------------------------------------------------------
sanitize_relpath() {
    local raw="$1" part
    case "$raw" in
        ""|.) return 1 ;;   # empty path
        /*)   return 1 ;;   # absolute path - never allowed
    esac
    raw="${raw#./}"         # tolerate a leading ./
    local -a clean=()
    local IFS='/'
    read -r -a parts <<< "$raw"
    for part in "${parts[@]}"; do
        case "$part" in
            ""|"."|"..") return 1 ;;  # empty, current-dir or parent-dir segment
        esac
        clean+=("$part")
    done
    [ "${#clean[@]}" -eq 0 ] && return 1
    ( IFS='/'; printf '%s' "${clean[*]}" )
}

# Strip <think> blocks and markdown fences from model output.
strip_model_noise() {
    perl -0777 -pe 's/<think>.*?<\/think>//gs; s/```[a-zA-Z]*\s*\n?//g; s/```//g' | tr -d '\r'
}

# ---------------------------------------------------------------------------
# Agent mode: multi-model sandboxed autonomous loop.
#
# Three roles, each runnable on a different local model:
#   architect -> writes a step plan + machine-readable <DELIVERABLES> list
#   builder   -> ReAct loop with filesystem tools (read/write/ls/run/done),
#                steered by a live MISSING/done checklist injected every step
#   reviewer  -> critiques changed files against the checklist; sends the
#                builder back with file-specific notes
#
# The checklist is the core steering mechanism: small models wander without
# explicit state, so every builder prompt leads with TASK + DELIVERABLES +
# recent history (rolling window), and `done` is rejected while anything is
# still MISSING.
#
# Safety: every path is jailed to the project dir (sanitize_relpath), shell
# commands are denied by policy list and then run sandboxed (bwrap), confirmed
# interactively, or not at all (dry-run) depending on AGENT_MODE.
# ---------------------------------------------------------------------------

# Extract the first <TOOL>...</TOOL> block from stdin.
extract_tool_json() {
    perl -0777 -ne 'if (/<TOOL>(.*?)<\/TOOL>/s) { print $1; }'
}

# Extract the first <VERDICT>...</VERDICT> block from stdin.
extract_verdict_json() {
    perl -0777 -ne 'if (/<VERDICT>(.*?)<\/VERDICT>/s) { print $1; }'
}

# Parse a tool-call JSON doc from stdin.
# Prints three NUL-separated fields: tool name, first arg, second arg.
# Forgiving: if the whole block isn't valid JSON, falls back to the first
# {...} object found inside it (models often wrap JSON in prose).
parse_tool_call() {
    python3 -c '
import sys, json, re
raw = sys.stdin.read()
def emit(tool, a1, a2):
    sys.stdout.write("\x00".join([tool, a1, a2]))
d = None
try:
    d = json.loads(raw)
except Exception:
    m = re.search(r"\{.*\}", raw, re.S)
    if m:
        try:
            d = json.loads(m.group(0))
        except Exception:
            d = None
if d is None:
    emit("!parse-error", "", "")
    sys.exit(0)
tool = str(d.get("tool", ""))
a1 = a2 = ""
if tool in ("read", "ls"):
    a1 = str(d.get("path", ""))
elif tool in ("write", "append"):
    a1 = str(d.get("path", ""))
    a2 = str(d.get("content", ""))
elif tool == "progress":
    a1 = str(d.get("path", ""))
    a2 = str(d.get("section", ""))
elif tool == "run":
    a1 = str(d.get("command", ""))
    a1 = str(d.get("command", ""))
elif tool == "remember":
    a1 = str(d.get("scope", "project"))
    a2 = str(d.get("fact", ""))
elif tool == "done":
    a1 = str(d.get("summary", ""))
emit(tool, a1, a2)
'
}

# Parse a reviewer verdict JSON doc from stdin -> "verdict\0notes".
parse_verdict() {
    python3 -c '
import sys, json
try:
    d = json.loads(sys.stdin.read())
except Exception:
    sys.stdout.write("!parse-error\x00")
    sys.exit(0)
sys.stdout.write(str(d.get("verdict", "")) + "\x00" + str(d.get("notes", "")))
'
}

# Parse the architect's <DELIVERABLES> JSON array from stdin.
# Prints "path|purpose|sec1;sec2;sec3" lines (sections may be empty).
# Exit 1 = no block, 2 = invalid JSON.
parse_deliverables() {
    python3 -c '
import sys, json, re
raw = sys.stdin.read()
m = re.search(r"<DELIVERABLES>(.*?)</DELIVERABLES>", raw, re.S)
if not m:
    sys.exit(1)
try:
    items = json.loads(m.group(1))
except Exception:
    sys.exit(2)
def clean(s):
    return re.sub(r"[|;]", "", str(s)).strip()
for it in items:
    if not isinstance(it, dict):
        continue
    p = clean(it.get("path", ""))
    if not p:
        continue
    purpose = clean(it.get("purpose", ""))
    secs = it.get("sections", []) or []
    sec_str = ";".join(clean(s) for s in secs if clean(s))
    print(p + "|" + purpose + "|" + sec_str)
'
}

# Safety policy for the `run` tool: never allow these, even sandboxed.
agent_cmd_denied() {
    local lc
    lc="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    case "$lc" in
        *sudo*|*su\ -*|*su\ root*|*mkfs*|*"dd "*|*fdisk*|*shutdown*|*reboot*|*poweroff*|*halt*|*":(){"*|*rm\ -rf\ /*|*rm\ -rf\ ~*)
            return 0 ;;
    esac
    return 1
}

# Run a command inside a bubblewrap jail: project dir read-write, the base
# system read-only, no network, no home directory, nothing else visible.
agent_run_sandboxed() {
    local cmd="$1" proj="$2"
    local -a binds=()
    local d
    for d in /usr /bin /sbin /lib /lib64 /etc; do
        [ -e "$d" ] && binds+=(--ro-bind "$d" "$d")
    done
    printf '%s' "$cmd" | timeout "${AGENT_CMD_TIMEOUT:-60}" bwrap \
        --unshare-net --die-with-parent \
        "${binds[@]}" \
        --bind "$proj" "$proj" \
        --tmpfs /tmp --proc /proc --dev /dev \
        --chdir "$proj" \
        --setenv PATH /usr/local/bin:/usr/bin:/bin \
        --setenv HOME /tmp \
        bash -s 2>&1
}

# Run a command only after the user approves it interactively.
agent_run_confirmed() {
    local cmd="$1" ans=""
    echo "Agent wants to run:"
    echo "  $cmd"
    read -r -p "Allow this command? (y/N): " ans || ans=""
    case "$ans" in
        y|Y) timeout "${AGENT_CMD_TIMEOUT:-60}" bash -c "$cmd" 2>&1 ;;
        *)   echo "[denied by user]" ;;
    esac
}

# Extract ALL <TOOL>...</TOOL> blocks from stdin, separated by \x1e.
extract_tool_json_all() {
    perl -0777 -ne 'while (/<TOOL>(.*?)<\/TOOL>/sg) { print "$1\x1e"; }'
}

# Strip all <TOOL>...</TOOL> blocks from stdin (for narration display).
strip_tool_blocks() {
    perl -0777 -pe 's/<TOOL>.*?<\/TOOL>//sg'
}

# Execute one chat tool call. Needs (via dynamic scope): MODE, PROJ,
# OUT_CHARS, NL, MEM_PROJ, MEM_GLOBAL. Sets TOOL_RESULT (truncated).
chat_exec_tool() {
    local tool="$1" a1="$2" a2="$3"
    local sp="" out="" rc=0
    case "$tool" in
        '!parse-error')
            TOOL_RESULT="That was not valid JSON, and no JSON object could be recovered. Emit clean JSON inside <TOOL> blocks." ;;
        read)
            if sp="$(sanitize_relpath "$a1")"; then
                if [ -f "$PROJ/$sp" ]; then
                    TOOL_RESULT="$(cat "$PROJ/$sp")"
                else
                    TOOL_RESULT="ERROR: file not found: $sp"
                fi
            else
                TOOL_RESULT="ERROR: path rejected (must be relative, no ..): $a1"
            fi ;;
        ls)
            if [ "$a1" = "." ] || [ "$a1" = "./" ] || [ -z "$a1" ]; then
                sp="."
            else
                sp="$(sanitize_relpath "$a1")" || sp=""
            fi
            if [ -n "$sp" ] && [ -d "$PROJ/$sp" ]; then
                TOOL_RESULT="$(ls -la "$PROJ/$sp")"
            else
                TOOL_RESULT="ERROR: not a directory or path rejected: $a1"
            fi ;;
        write)
            if sp="$(sanitize_relpath "$a1")"; then
                if [ "$MODE" = "dry-run" ]; then
                    TOOL_RESULT="dry-run: would write ${#a2} chars to: $sp (not executed)"
                else
                    mkdir -p "$PROJ/$(dirname "$sp")"
                    printf '%s\n' "$a2" > "$PROJ/$sp"
                    TOOL_RESULT="wrote $sp"
                fi
            else
                TOOL_RESULT="ERROR: path rejected (must be relative, no ..): $a1"
            fi ;;
        append)
            if sp="$(sanitize_relpath "$a1")"; then
                if [ "$MODE" = "dry-run" ]; then
                    TOOL_RESULT="dry-run: would append ${#a2} chars to: $sp (not executed)"
                elif [ ! -f "$PROJ/$sp" ]; then
                    TOOL_RESULT="ERROR: cannot append to $sp: file does not exist yet. Use write first."
                else
                    printf '%s\n' "$a2" >> "$PROJ/$sp"
                    TOOL_RESULT="appended ${#a2} chars to $sp"
                fi
            else
                TOOL_RESULT="ERROR: path rejected (must be relative, no ..): $a1"
            fi ;;
        run)
            if agent_cmd_denied "$a1"; then
                TOOL_RESULT="ERROR: command denied by safety policy."
            elif [ "$MODE" = "dry-run" ]; then
                TOOL_RESULT="dry-run: would run: $a1 (not executed)"
            elif [ "$MODE" = "sandbox" ]; then
                out="$(agent_run_sandboxed "$a1" "$PROJ")"; rc=$?
                TOOL_RESULT="[exit $rc]${NL}$out"
            else
                out="$(agent_run_confirmed "$a1")"; rc=$?
                TOOL_RESULT="[exit $rc]${NL}$out"
            fi ;;
        remember)
            local scope="project" memfile="$MEM_PROJ"
            if [ "$a1" = "global" ]; then scope="global"; memfile="$MEM_GLOBAL"; fi
            if [ -z "$a2" ]; then
                TOOL_RESULT="ERROR: remember needs a fact."
            else
                mkdir -p "$(dirname "$memfile")"
                [ -f "$memfile" ] || printf '# aicli memory\n\n' > "$memfile"
                printf -- '- %s\n' "$a2" >> "$memfile"
                TOOL_RESULT="remembered ($scope): $a2"
            fi ;;
        *)
            TOOL_RESULT="ERROR: unknown tool '$tool'. Available: read, write, append, ls, run, remember." ;;
    esac
    TOOL_RESULT="$(printf '%s' "$TOOL_RESULT" | head -c "$OUT_CHARS")"
}

# aicli agent [--flags] "task description"
cmd_agent() {
    local ARCH_M="$ARCHITECT_MODEL" BUILD_M="$BUILDER_MODEL" REV_M="$REVIEWER_MODEL"
    local MODE="$AGENT_MODE" MAX_STEPS="$AGENT_MAX_STEPS" MAX_REV="$AGENT_MAX_REVISIONS"
    local OUT_CHARS="$AGENT_MAX_OUTPUT_CHARS" MODEL_TIMEOUT="$AGENT_MODEL_TIMEOUT"
    local HIST_KEPT="$AGENT_HISTORY_KEPT"
    local DO_REVIEW=1
    local CHAT=0 MAX_STEPS_SET=0 MAX_REV_SET=0 PROJECT=0 THOROUGH=0
    local NL=$'\n'

    local -a CHANGED=() HIST=()
    local -a DELIV_PATHS=() DELIV_PURPOSE=() DELIV_DONE=() DELIV_SECS=()
    local step=0 rev=0 finished=0 notool_streak=0 done_reject_streak=0
    local LAST_WHASH="" SAME_WRITE_COUNT=0
    local tool_result="" prev_sig=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --architect-model)
                [ $# -ge 2 ] || { echo "Flag --architect-model needs a value." >&2; return 1; }
                ARCH_M="$2"; shift 2 ;;
            --builder-model)
                [ $# -ge 2 ] || { echo "Flag --builder-model needs a value." >&2; return 1; }
                BUILD_M="$2"; shift 2 ;;
            --reviewer-model)
                [ $# -ge 2 ] || { echo "Flag --reviewer-model needs a value." >&2; return 1; }
                REV_M="$2"; shift 2 ;;
            --mode)
                [ $# -ge 2 ] || { echo "Flag --mode needs a value." >&2; return 1; }
                MODE="$2"; shift 2 ;;
            --max-steps)
                [ $# -ge 2 ] || { echo "Flag --max-steps needs a value." >&2; return 1; }
                MAX_STEPS="$2"; MAX_STEPS_SET=1; shift 2 ;;
            --max-revisions)
                [ $# -ge 2 ] || { echo "Flag --max-revisions needs a value." >&2; return 1; }
                MAX_REV="$2"; MAX_REV_SET=1; shift 2 ;;
            --no-review) DO_REVIEW=0; shift ;;
            --project) PROJECT=1; shift ;;
            --thorough) THOROUGH=1; shift ;;
            --chat) CHAT=1; shift ;;
            --) shift; break ;;
            -*) echo "Unknown agent flag: $1" >&2; return 1 ;;
            *) break ;;
        esac
    done

    local TASK="$*"
    if [ "$CHAT" -eq 1 ]; then
        # Interactive mode: remaining args (if any) are the opening message.
        local CHAT_STEPS="$CHAT_MAX_STEPS"
        [ "$MAX_STEPS_SET" -eq 1 ] && CHAT_STEPS="$MAX_STEPS"
        cmd_agent_chat "$BUILD_M" "$MODE" "$CHAT_STEPS" "$TASK"
        return $?
    fi
    if [ -z "$TASK" ]; then
        echo "Usage: aicli agent [flags] \"task description\"" >&2
        echo "Flags: --architect-model M --builder-model M --reviewer-model M" >&2
        echo "       --mode sandbox|confirm|dry-run" >&2
        echo "       --max-steps N --max-revisions N --no-review --project --thorough --chat" >&2
        echo "       --project: section-by-section build with a progress checklist" >&2
        echo "       --thorough: plan critique loop, verify-per-section, higher caps (slow)" >&2
        return 1
    fi

    case "$MODE" in
        sandbox|confirm|dry-run) ;;
        *) echo "Error: --mode must be sandbox, confirm, or dry-run." >&2; return 1 ;;
    esac
    [[ "$MAX_STEPS" =~ ^[1-9][0-9]*$ ]] || { echo "Error: --max-steps must be a positive integer." >&2; return 1; }

    [[ "$MAX_REV" =~ ^[0-9]+$ ]] || { echo "Error: --max-revisions must be a non-negative integer." >&2; return 1; }
    if [ "$PROJECT" -eq 1 ] && [ "$MAX_STEPS_SET" -eq 0 ]; then
        MAX_STEPS=40  # section-by-section builds need more steps
    fi
    if [ "$THOROUGH" -eq 1 ]; then
        [ "$MAX_STEPS_SET" -eq 0 ] && MAX_STEPS=80
        [ "$MAX_REV_SET" -eq 0 ] && MAX_REV=5
    fi

    local m
    for m in "$ARCH_M" "$BUILD_M"; do
        if ! ollama list | awk 'NR>1 {print $1}' | grep -qxF -- "$m"; then
            echo "Error: model '$m' is not downloaded. Pull it first: ollama pull $m" >&2
            return 1
        fi
    done
    if [ "$DO_REVIEW" -eq 1 ] && ! ollama list | awk 'NR>1 {print $1}' | grep -qxF -- "$REV_M"; then
        echo "Error: reviewer model '$REV_M' is not downloaded. Pull it first, or pass --no-review." >&2
        return 1
    fi

    if [ "$MODE" = "sandbox" ] && ! command -v bwrap >/dev/null 2>&1; then
        echo "Warning: 'bwrap' not found; sandbox mode unavailable. Falling back to confirm mode." >&2
        MODE="confirm"
    fi

    # The agent's whole world: everything it reads/writes happens under here.
    local PROJ="$PWD"

    # Run log: mirror everything to .aicli/run-<timestamp>.log so progress can
    # be watched live (tail -f) or reviewed after the run.
    local AGENT_LOG="$PROJ/.aicli/run-$(date +%Y%m%d-%H%M%S)-$$.log"
    mkdir -p "$PROJ/.aicli"
    exec > >(tee -a "$AGENT_LOG") 2>&1
    echo "AGENT: logging this run to $AGENT_LOG"
    # ---- Small helpers, defined here so they see cmd_agent's locals ----
    # (bash uses dynamic scoping: functions called from inside cmd_agent
    # can read its local variables).
    agent_deliv_status() {
        local i
        if [ "${#DELIV_PATHS[@]}" -eq 0 ]; then
            printf '  (no deliverables list; use your best judgment)\n'
            return
        fi
        for i in "${!DELIV_PATHS[@]}"; do
            if [ "${DELIV_DONE[$i]}" = "1" ]; then
                printf '  [done] %s\n' "${DELIV_PATHS[$i]}"
            else
                printf '  [MISSING] %s -- %s\n' "${DELIV_PATHS[$i]}" "${DELIV_PURPOSE[$i]}"
            fi
        done
    }
    agent_deliv_missing() {
        local i
        for i in "${!DELIV_PATHS[@]}"; do
            if [ "${DELIV_DONE[$i]}" != "1" ]; then
                printf '%s\n' "${DELIV_PATHS[$i]}"
            fi
        done
    }
    agent_mark_done() {
        local target="$1" i
        for i in "${!DELIV_PATHS[@]}"; do
            if [ "${DELIV_PATHS[$i]}" = "$target" ]; then
                DELIV_DONE[$i]=1
            fi
        done
    }
    # ---- Project mode: .aicli/progress.md is the harness-owned checklist ----
    # The architect breaks each deliverable into sections; the builder checks
    # them off with the `progress` tool. The done-gate reads this file, so a
    # model cannot fake completion by vibes.
    project_progress_init() {
        local pf="$PROJ/.aicli/progress.md"
        mkdir -p "$PROJ/.aicli"
        {
            printf '# Build progress\n'
            printf '# Updated via the `progress` tool. Do not edit by hand.\n'
            local i s
            for i in "${!DELIV_PATHS[@]}"; do
                printf -- '- [ ] %s -- %s\n' "${DELIV_PATHS[$i]}" "${DELIV_PURPOSE[$i]}"
                local IFS=';'
                for s in ${DELIV_SECS[$i]}; do
                    [ -n "$s" ] && printf -- '  - [ ] %s\n' "$s"
                done
                unset IFS
            done
        } > "$pf"
    }
    # Mark a section done. Prints the result; exit 0 = marked, 2 = no match.
    # On success also checks the file box when its last section completes.
    project_progress_mark() {
        local path="$1" section="$2"
        python3 - "$PROJ/.aicli/progress.md" "$path" "$section" <<'PYEOF'
import sys, re
pf, target_path, target_sec = sys.argv[1], sys.argv[2], sys.argv[3]
def norm(s):
    return re.sub(r'[^a-z0-9]', '', s.lower())
lines = open(pf).read().split('\n')
fi = None
for i, ln in enumerate(lines):
    m = re.match(r'- \[[ x]\] (\S+)\s*--', ln)
    if m and norm(m.group(1)) == norm(target_path):
        fi = i
        break
if fi is None:
    print("ERROR: '%s' is not in the progress file." % target_path)
    sys.exit(2)
secs = []
j = fi + 1
while j < len(lines) and lines[j].startswith('  - ['):
    m = re.match(r'  - \[[ x]\] (.*)', lines[j])
    if m:
        secs.append(j)
    j += 1
if not secs:
    if target_sec.strip():
        print("ERROR: '%s' has no sections; call progress with an empty section." % target_path)
        sys.exit(2)
    lines[fi] = lines[fi].replace('- [ ]', '- [x]', 1)
    open(pf, 'w').write('\n'.join(lines))
    print("checked off: %s (all sections done)" % target_path)
    sys.exit(0)
hit = None
for idx in secs:
    name = re.match(r'  - \[[ x]\] (.*)', lines[idx]).group(1)
    if norm(name) == norm(target_sec):
        hit = (idx, name)
        break
if hit is None:
    valid = ", ".join(re.match(r'  - \[[ x]\] (.*)', lines[i]).group(1) for i in secs)
    print("ERROR: no section '%s' under %s. Valid sections: %s" % (target_sec, target_path, valid))
    sys.exit(2)
idx, name = hit
if lines[idx].startswith('  - [x]'):
    print("NOTE: section '%s' was already checked off." % name)
else:
    lines[idx] = lines[idx].replace('- [ ]', '- [x]', 1)
    print("checked off: %s -- %s" % (target_path, name))
if all(lines[i].startswith('  - [x]') for i in secs):
