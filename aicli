#!/usr/bin/env bash
#
# aicli - Unified Local AI Developer Suite, powered by Ollama.
#
# One binary, four workflows:
#   aicli ask     Quick shell assistant / single-prompt Q&A        (alias: ai)
#   aicli arch    System architecture blueprints & JSON file trees  (alias: aarch)
#   aicli build   Autonomous multi-file project builder            (alias: abuild)
#   aicli model   View or switch the active Ollama model
#   aicli config  View or change aicli settings
#
# The ai / aarch / abuild entry points are just symlinks (or tiny wrappers)
# pointing at this script; the real subcommand is derived from how we were
# invoked (see "alias dispatch" below).

set -uo pipefail

# ---------------------------------------------------------------------------
# Resolve the real script directory, even when invoked through symlinks.
# ---------------------------------------------------------------------------
TARGET_FILE="${BASH_SOURCE[0]}"
while [ -L "$TARGET_FILE" ]; do
    TARGET_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"
    TARGET_FILE="$(readlink "$TARGET_FILE")"
    [[ $TARGET_FILE != /* ]] && TARGET_FILE="$TARGET_DIR/$TARGET_FILE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"

# ---------------------------------------------------------------------------
# Dependency checks - fail fast with a helpful message instead of a
# cryptic "command not found" halfway through a build.
# ---------------------------------------------------------------------------
for _dep in ollama python3 perl; do
    if ! command -v "$_dep" >/dev/null 2>&1; then
        echo "Error: required command '$_dep' was not found on PATH." >&2
        echo "Install it first: Ollama from https://ollama.com, python3 and perl from your package manager." >&2
        exit 127
    fi
done
unset _dep

# ---------------------------------------------------------------------------
# Configuration. Defaults are overridden by config.env (KEY="value" lines).
# ---------------------------------------------------------------------------
CONFIG_FILE="$SCRIPT_DIR/config.env"

CHAT_MODEL="qwen2.5-coder:7b"
# How many of the most recently generated files are fed back to the model as
# context while building the next file. Caps prompt size on large projects so
# the model's context window isn't blown out by cumulative history.
CONTEXT_WINDOW_FILES=5

# --- Agent mode defaults (overridable via config.env / `aicli config`) ---
# Autonomy: sandbox (bwrap jail, no prompts), confirm (ask before each shell
# command), or dry-run (print tool calls, execute nothing).
AGENT_MODE="sandbox"
AGENT_MAX_STEPS=25          # max tool-call turns per agent run (all phases)
AGENT_MAX_REVISIONS=2       # reviewer -> builder fix rounds
AGENT_MAX_OUTPUT_CHARS=4000 # truncate individual tool outputs to this
AGENT_CMD_TIMEOUT=60        # seconds: per shell command run by the agent
AGENT_MODEL_TIMEOUT=300     # seconds: per model call timeout
AGENT_HISTORY_KEPT=6        # builder prompt keeps this many recent tool exchanges verbatim
CHAT_HISTORY_TURNS=10       # chat: conversation turns kept in each prompt
CHAT_MAX_STEPS=15           # chat: max tool steps per turn before the model must reply

if [ -f "$CONFIG_FILE" ]; then
    # config.env only ever holds simple KEY="value" assignments written by us.
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

# Role models for agent mode: which model architects, builds, and reviews.
# Each falls back to CHAT_MODEL when unset, so changing the main model
# automatically moves all three roles unless overridden individually.
: "${ARCHITECT_MODEL:=$CHAT_MODEL}"
: "${BUILDER_MODEL:=$CHAT_MODEL}"
: "${REVIEWER_MODEL:=$CHAT_MODEL}"

# Persist one config key without clobbering the others.
save_config() {
    local key="$1" value="$2" tmp
    tmp="$(mktemp)" || { echo "Error: could not create temp file." >&2; return 1; }
    if [ -f "$CONFIG_FILE" ]; then
        grep -v "^${key}=" "$CONFIG_FILE" > "$tmp" 2>/dev/null || true
    fi
    printf '%s="%s"\n' "$key" "$value" >> "$tmp"
    mv "$tmp" "$CONFIG_FILE"
}

VERSION="2.9.0 (ai v1.0.0 | aarch v1.0.0 | abuild v1.6.0 | aagent v1.5.0)"

# ---------------------------------------------------------------------------
# Alias dispatch: `ai`, `aarch`, `abuild` are symlinks to this script.
# Translate the invocation name into the real subcommand so the README's
# symlink install (`ln -s .../aicli ~/.local/bin/ai`) actually works.
# ---------------------------------------------------------------------------
case "$(basename "$0")" in
    ai)     set -- ask "$@" ;;
    aarch)  set -- arch "$@" ;;
    abuild) set -- build "$@" ;;
    aagent) set -- agent "$@" ;;
esac

