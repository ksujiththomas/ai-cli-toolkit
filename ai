#!/usr/bin/env bash

# Resolve actual script directory even when invoked via symlink
TARGET_FILE="${BASH_SOURCE[0]}"
while [ -L "$TARGET_FILE" ]; do
    TARGET_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"
    TARGET_FILE="$(readlink "$TARGET_FILE")"
    [[ $TARGET_FILE != /* ]] && TARGET_FILE="$TARGET_DIR/$TARGET_FILE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"

if [ -f "$SCRIPT_DIR/config.env" ]; then
    source "$SCRIPT_DIR/config.env"
else
    echo "Error: config.env not found in $SCRIPT_DIR"
    exit 1
fi

TODAY=$(date +%Y-%m-%d)
SUMMARY_FILE="$SUM_DIR/$TODAY.md"
INDEX_FILE="$IDX_DIR/$TODAY.keywords"

mkdir -p "$SUM_DIR" "$IDX_DIR"
touch "$SUMMARY_FILE" "$INDEX_FILE"

# Mode: Search past memory files
if [ "$1" == "--search" ]; then
    QUERY="$2"
    if [ -z "$QUERY" ]; then
        echo "Usage: ai --search <keyword>"
        exit 1
    fi
    echo "=== Index Matches ==="
    grep -rn -i "$QUERY" "$IDX_DIR/" 2>/dev/null
    echo -e "\n=== Summary Content Matches ==="
    grep -rn -i "$QUERY" "$SUM_DIR/" 2>/dev/null
    exit 0
fi

# Mode: Standard Chat Prompt
USER_PROMPT="$*"
if [ -z "$USER_PROMPT" ]; then
    echo "Usage: ai \"your query\" OR ai --search \"keyword\""
    exit 1
fi

# Read context and keep linebreaks intact
DAILY_CONTEXT=$(cat "$SUMMARY_FILE")

SYSTEM_PROMPT="You are a CLI terminal assistant. Always keep answers concise.
Past context summary for today ($TODAY):
${DAILY_CONTEXT:-None yet}"

echo -e "\n[AI Thinking...]\n"

# Run main inference safely using heredoc format
RESPONSE=$(ollama run "$CHAT_MODEL" <<INSIDE_HEREDOC
System: $SYSTEM_PROMPT
User: $USER_PROMPT
INSIDE_HEREDOC
)

echo -e "$RESPONSE\n"

# Background Job: Asynchronously process summaries and keywords
(
    TIME=$(date +%H:%M)

    # 1. Ask fast model for brief facts
    RAW_SUM=$(ollama run "$SUMMARY_MODEL" <<SUM_HEREDOC
Summarize key technical facts/actions from this turn in 2 short bullet points. Do not include thinking or explanations.
User: $USER_PROMPT
AI: $RESPONSE
SUM_HEREDOC
)
    
    # Strip <think> tags AND Ollama's "Thinking... ...done thinking." blocks across multiple lines
    CLEAN_SUM=$(echo "$RAW_SUM" | perl -0777 -pe 's/<think>.*?<\/think>//gs; s/Thinking\b.*?\.\.\.done thinking\.?//gis' | tr '\n' ' ' | sed 's/  */ /g')
    
    if [ -n "$CLEAN_SUM" ]; then
        echo "- $TIME | $CLEAN_SUM" >> "$SUMMARY_FILE"
    fi

    # 2. Extract keywords for quick lookup
    RAW_KEYS=$(ollama run "$SUMMARY_MODEL" <<KEY_HEREDOC
Extract 3 to 5 search keywords (including any numbers or ports) for this text. Output CSV format only.
User: $USER_PROMPT
Summary: $CLEAN_SUM
KEY_HEREDOC
)
    
    CLEAN_KEYS=$(echo "$RAW_KEYS" | perl -0777 -pe 's/<think>.*?<\/think>//gs; s/Thinking\b.*?\.\.\.done thinking\.?//gis' | tr '\n' ' ' | sed 's/  */ /g')
    echo "$TIME | $CLEAN_KEYS" >> "$INDEX_FILE"
) & disown

